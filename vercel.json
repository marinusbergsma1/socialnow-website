{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/fonts/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=2592000, stale-while-revalidate=31536000"
        }
      ]
    },
    {
      "source": "/(images|video|videos|proposal)/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600, stale-while-revalidate=604800"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/:pad*",
      "has": [{ "type": "host", "value": "security.socialnow.nl" }],
      "destination": "https://socialnow.nl/security",
      "permanent": true
    },
    {
      "source": "/prijzen",
      "destination": "/diensten#prijzen",
      "permanent": true
    },
    {
      "source": "/:taal(nl|de|fr|es|it|pt|pl|sv|da)/prijzen",
      "destination": "/:taal/diensten#prijzen",
      "permanent": true
    },
    {
      "source": "/check",
      "destination": "/security",
      "permanent": true
    },
    {
      "source": "/:taal(nl|de|fr|es|it|pt|pl|sv|da)/check",
      "destination": "/:taal/security",
      "permanent": true
    },
    {
      "source": "/php-check",
      "destination": "/security",
      "permanent": true
    },
    {
      "source": "/:taal(nl|de|fr|es|it|pt|pl|sv|da)/php-check",
      "destination": "/:taal/security",
      "permanent": true
    }
  ],
  "functions": {
    "api/check-rapport.js": {
      "maxDuration": 60
    }
  }
}
